)

cc_library(
    name = "ignore_warnings",
    hdrs = ["ignore_warnings.h"],
    copts = COPTS,
)

cc_library(
    name = "inline",
    hdrs = ["inline.h"],
    copts = COPTS,
)

cc_library(
    name = "no_unique_address",
    hdrs = ["no_unique_address.h"],
    copts = COPTS,
)

cc_library(
    name = "rtc_export",
    hdrs = [
        "rtc_export.h",
        "rtc_export_template.h",
    ],
    copts = COPTS,
)

cc_library(
    name = "unused",
    hdrs = ["unused.h"],
    copts = COPTS,
)

cc_library(
    name = "warn_current_thread_is_deadlocked",
    hdrs = ["warn_current_thread_is_deadlocked.h"],
    copts = COPTS,
