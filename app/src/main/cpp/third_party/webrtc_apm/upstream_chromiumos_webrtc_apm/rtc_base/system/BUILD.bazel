load("//:defs.bzl", "COPTS")

package(
    default_visibility = ["//:__subpackages__"],
)

cc_library(
    name = "arch",
    hdrs = ["arch.h"],
    copts = COPTS,
)

cc_library(
    name = "file_wrapper",
    srcs = ["file_wrapper.cc"],
    hdrs = ["file_wrapper.h"],
    copts = COPTS,
    deps = [
        "//rtc_base:checks",
        "//rtc_base:criticalsection",
        "//rtc_base:safe_conversions",
        "@com_google_absl//absl/strings:string_view",
