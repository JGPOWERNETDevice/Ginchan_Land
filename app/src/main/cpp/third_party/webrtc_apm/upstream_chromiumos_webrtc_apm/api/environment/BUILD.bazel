load("//:defs.bzl", "COPTS")

package(
    default_visibility = ["//:__subpackages__"],
)

cc_library(
    name = "deprecated_global_field_trials",
    srcs = ["deprecated_global_field_trials.cc"],
    hdrs = ["deprecated_global_field_trials.h"],
    copts = COPTS,
    deps = [
        "//api:field_trials_registry",
        "//system_wrappers:field_trial",
        "@com_google_absl//absl/strings:string_view",
    ],
)

cc_library(
    name = "environment",
    hdrs = ["environment.h"],
    copts = COPTS,
    deps = [
        "//api:field_trials_view",
        "//api:refcountedbase",
        "//api:scoped_refptr",
        "//api/rtc_event_log",
        "//api/task_queue",
        "//rtc_base/system:rtc_export",
        "//system_wrappers",
        "@com_google_absl//absl/base:nullability",
    ],
)

cc_library(
    name = "environment_factory",
    srcs = ["environment_factory.cc"],
    hdrs = ["environment_factory.h"],
    copts = COPTS,
    deps = [
        ":deprecated_global_field_trials",
        ":environment",
        "//api:field_trials_view",
        "//api:make_ref_counted",
        "//api:refcountedbase",
        "//api:scoped_refptr",
        "//api/rtc_event_log",
        "//api/task_queue",
        "//api/task_queue:default_task_queue_factory",
        "//rtc_base:checks",
        "//rtc_base/system:rtc_export",
        "//system_wrappers",
        "@com_google_absl//absl/base:nullability",
    ],
)
