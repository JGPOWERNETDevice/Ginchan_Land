load("//:defs.bzl", "COPTS")

package(
    default_visibility = ["//:__subpackages__"],
)

cc_library(
    name = "default_task_queue_factory",
    srcs = ["default_task_queue_factory_stdlib.cc"],
    hdrs = ["default_task_queue_factory.h"],
    copts = COPTS,
    deps = [
        ":task_queue",
        "//api:field_trials_view",
        "//rtc_base:rtc_task_queue_stdlib",
