load("//:defs.bzl", "COPTS")

package(
    default_visibility = ["//:__subpackages__"],
)

cc_library(
    name = "aecm_core",
    srcs = [
        "aecm_core.cc",
        "aecm_core_c.cc",
        "echo_control_mobile.cc",
    ] + select({
        "//:neon_build": ["aecm_core_neon.cc"],
        "//conditions:default": [],
    }),
    hdrs = [
        "aecm_core.h",
        "aecm_defines.h",
        "echo_control_mobile.h",
    ],
    copts = COPTS,
    deps = [
        "//common_audio:common_audio_c",
        "//modules/audio_processing/utility:legacy_delay_estimator",
        "//rtc_base:checks",
        "//rtc_base:safe_conversions",
        "//rtc_base:sanitizer",
    ],
)
